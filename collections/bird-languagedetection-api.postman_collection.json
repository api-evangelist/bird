          "name": "Predict language",
          "request": {
            "name": "Predict language",
            "description": {
              "content": "Predicts the language for a given phrase. If the language could not be determined, it returns LANGUAGE_UNDETERMINED. Uses the ISO-639-3 standard.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v1",
                "predict-language"
              ],
